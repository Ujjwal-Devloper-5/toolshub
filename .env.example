# ==============================================================================
# ToolsHub Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# AI Subsystem Configuration
# ------------------------------------------------------------------------------
# Provider options: ollama | openai | anthropic | openrouter
TOOLSHUB_AI_PROVIDER=ollama

# LLM model name (e.g., llama3.2, gpt-4o, claude-3-5-sonnet-20241022)
TOOLSHUB_AI_MODEL=llama3.2

# Custom API endpoint URL
TOOLSHUB_AI_ENDPOINT=http://localhost:11434

# API Key for cloud providers (OpenAI / Anthropic / OpenRouter)
TOOLSHUB_AI_API_KEY=your_api_key_here

# Maximum token response limit
TOOLSHUB_AI_MAX_TOKENS=4096

# Sampling temperature (0.0 to 2.0)
TOOLSHUB_AI_TEMPERATURE=0.7

# ------------------------------------------------------------------------------
# Memory & Storage Subsystem
# ------------------------------------------------------------------------------
# Enable or disable persistent SQLite memory (true/false)
TOOLSHUB_MEMORY_ENABLED=true

# Path to the SQLite memory database file
TOOLSHUB_DB_PATH=~/.local/share/toolshub/memory.db

# ------------------------------------------------------------------------------
# Logging & Debugging
# ------------------------------------------------------------------------------
# Log level filter (error, warn, info, debug, trace, or crate-specific e.g. toolshub_cli=debug)
RUST_LOG=info

# ------------------------------------------------------------------------------
# Environment & Display Preferences
# ------------------------------------------------------------------------------
# Preferred text editor for editing config files
EDITOR=nano

# Set to 1 or true to disable colorized terminal output (leave blank/0 for color)
NO_COLOR=
