# ==============================================================================
# ToolsHub Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# AI Subsystem Configuration
# ------------------------------------------------------------------------------
# Provider options: ollama | openai | anthropic | openrouter
TOOLSHUB_AI_PROVIDER=openrouter

# LLM model name (e.g., meta-llama/llama-3.1-8b-instruct:free for OpenRouter)
TOOLSHUB_AI_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Comma-separated list of fallback models if the primary model fails
TOOLSHUB_AI_FALLBACK_MODELS=google/gemma-2-9b-it:free,microsoft/phi-3-mini-128k-instruct:free,mistralai/mistral-7b-instruct:free,qwen/qwen-2-7b-instruct:free

# Custom API endpoint URL (OpenRouter endpoint)
TOOLSHUB_AI_ENDPOINT=https://openrouter.ai/api

# API Key for cloud providers (Get yours at openrouter.ai)
TOOLSHUB_AI_API_KEY=your_openrouter_api_key_here

# Maximum token response limit
TOOLSHUB_AI_MAX_TOKENS=4096

# Sampling temperature (0.0 to 2.0)
TOOLSHUB_AI_TEMPERATURE=0.7

# ------------------------------------------------------------------------------
# Memory & Storage Subsystem
# ------------------------------------------------------------------------------
# Enable or disable persistent SQLite memory (true/false)
TOOLSHUB_MEMORY_ENABLED=true

# Path to the SQLite memory database file
TOOLSHUB_DB_PATH=~/.local/share/toolshub/memory.db

# ------------------------------------------------------------------------------
# Logging & Debugging
# ------------------------------------------------------------------------------
# Log level filter (error, warn, info, debug, trace, or crate-specific e.g. toolshub_cli=debug)
RUST_LOG=info

# ------------------------------------------------------------------------------
# Environment & Display Preferences
# ------------------------------------------------------------------------------
# Preferred text editor for editing config files
EDITOR=nano

# Set to 1 or true to disable colorized terminal output (leave blank/0 for color)
NO_COLOR=
